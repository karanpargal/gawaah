# Funded Tiramisu wallet used by scripts/ (seed, smoke test, gas drip).
# Generate one with `pnpm wallet:new` — never commit the real .env.
ARKIV_PRIVATE_KEY=

# Optional. The public RPC gives each IP a free query budget (429 ANON_COST_LIMITED when spent).
# A free key from https://hub.arkiv.network lifts it. Seeding needs one.
ARKIV_API_KEY=
# Optional. Any other Arkiv node.
ARKIV_RPC_URL=
